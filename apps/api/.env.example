# ─── Modo del servidor ───
# central: servidor de la oficina principal (dueño del catálogo, recibe ventas de todas las tiendas)
# store:   servidor de una tienda (las cajas se conectan aquí por LAN, vende sin internet)
SERVER_MODE=central
PORT=3000

# PostgreSQL nativo de Windows
DATABASE_URL=postgresql://pos:CAMBIAR@localhost:5432/pos_central?schema=public

# Clave para firmar los JWT (distinta en cada servidor, mínimo 32 caracteres)
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_123456

# ─── Solo servidores que venden (store, o central si también es tienda) ───
# ID de la sucursal que atiende este servidor
SUCURSAL_ID=

# ─── Solo modo store: conexión al servidor central (por VPN) ───
CENTRAL_URL=http://10.0.0.1:3000
# Token de sincronización de la sucursal (se genera en la web del central → Sucursales)
SYNC_TOKEN=
SYNC_INTERVALO_SEGUNDOS=30

# ─── Backups ───
PG_BIN=C:\Program Files\PostgreSQL\18\bin
BACKUP_DIR=C:\POS-backups
# Disco externo / NAS (opcional pero recomendado)
BACKUP_EXTERNAL_DIR=
BACKUP_RETENCION_DIAS=30
# Hora del backup diario (0-23)
BACKUP_HORA=23

# Carpeta con la web compilada (apps/web/dist) para servirla desde la API (opcional)
WEB_DIST=
