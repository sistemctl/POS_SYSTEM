{
  "name": "@pos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "pnpm run dev:central",
    "dev:central": "cross-env ENV_FILE=.env.central nest start --watch",
    "dev:store": "cross-env ENV_FILE=.env.store nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.central -- prisma migrate dev",
    "db:deploy:central": "dotenv -e .env.central -- prisma migrate deploy",
    "db:deploy:store": "dotenv -e .env.store -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.central -- ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@pos/shared": "workspace:*",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.4.3",
    "exceljs": "4.4.0",
    "multer": "2.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.16.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
